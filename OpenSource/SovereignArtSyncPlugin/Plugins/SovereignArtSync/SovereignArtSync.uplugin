{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0.0",
	"FriendlyName": "Sovereign Art Sync",
	"Description": "Zero-bloat local art asset synchronizer and auto-discovery engine for Unreal Engine 5. Decouples heavy binary .uasset files from Git source control.",
	"Category": "Editor",
	"CreatedBy": "Daniel Acourt",
	"CreatedByURL": "https://github.com/danielacourt",
	"DocsURL": "https://github.com/danielacourt/sovereign-art-sync",
	"MarketplaceURL": "com.epicgames.launcher://ue/marketplace/product/sovereign-art-sync",
	"SupportURL": "https://github.com/danielacourt/sovereign-art-sync/issues",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"EnabledByDefault": true,
	"Plugins": [
		{
			"Name": "PythonScriptPlugin",
			"Enabled": true
		},
		{
			"Name": "EditorScriptingUtilities",
			"Enabled": true
		}
	]
}
